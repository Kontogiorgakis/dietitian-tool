{
  "name": "next-auth-intl-prisma-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate --schema=lib/db/schema.prisma && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate --schema=lib/db/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=lib/db/schema.prisma",
    "db:seed": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local lib/db/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1132.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "framer-motion": "^13.3.0",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "next-auth": "^4.24.15",
    "next-intl": "^4.14.5",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.3.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prisma": "^7.10.0",
    "puppeteer": "^25.11.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0"
  },
  "prisma": {
    "schema": "lib/db/schema.prisma"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "puppeteer"
    ]
  }
}
